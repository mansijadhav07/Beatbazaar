# Beatbazaar Environment Configuration
# Copy this file to .env.local and populate with your credentials.
# Do not commit real secrets or credentials to version control.

# Node Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB Database Connection
# Atlas replica set connection string is recommended for transaction support
MONGODB_URI=mongodb://localhost:27017/beatbazaar
# Optional. Integration tests use only this explicitly named test database.
MONGODB_TEST_URI=mongodb://localhost:27017/beatbazaar_test

# Better Auth Configuration
BETTER_AUTH_SECRET=generate_a_random_32_byte_hex_or_base64_string
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (for artist and producer login)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Cloudflare R2 Storage
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_PUBLIC_BUCKET_NAME=beatbazaar-public
CLOUDFLARE_R2_PRIVATE_BUCKET_NAME=beatbazaar-private
NEXT_PUBLIC_R2_PUBLIC_DOMAIN=https://cdn.example.invalid
NEXT_PUBLIC_SUPPORT_EMAIL=

# Payment Gateways
# Razorpay (India: UPI, cards, netbanking)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
PLATFORM_FEE_PERCENT=
# Placeholder only. Confirm the refund policy before launch.
REFUND_WINDOW_DAYS=14
# Supported mode is test-mode Razorpay Route. Manual mode is not implemented.
PAYOUT_MODE=razorpay_route
# Producer payout UI and transfers remain disabled unless explicitly enabled.
PAYOUTS_ENABLED=false

# Transactional Email (Resend or Postmark)
EMAIL_SERVER_API_KEY=re_your_transactional_email_key
EMAIL_FROM=
