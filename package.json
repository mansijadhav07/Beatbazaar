{
  "name": "beatbazaar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev-test.ts",
    "build": "next build",
    "build:test": "tsx scripts/build-test.ts",
    "measure:perf:test": "node scripts/measure-lab-vitals.mjs",
    "start": "next start",
    "worker": "NODE_OPTIONS=\"--conditions=react-server\" tsx worker/index.ts",
    "lint": "eslint . --max-warnings=0 && tsc --noEmit",
    "test": "vitest run",
    "e2e": "node scripts/run-playwright.mjs",
    "db:migrate": "migrate-mongo up",
    "db:migrate:down": "migrate-mongo down",
    "db:seed": "tsx src/server/db/seed.ts",
    "db:create-admin": "tsx scripts/create-admin.ts",
    "smoke:local": "tsx scripts/smoke-local.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.750.0",
    "@better-auth/mongo-adapter": "^1.1.21",
    "@pdf-lib/fontkit": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "better-auth": "^1.1.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "lucide-react": "^0.475.0",
    "migrate-mongo": "^11.0.0",
    "mongodb": "^6.13.0",
    "mongoose": "^8.10.1",
    "next": "^15.5.29",
    "pdf-lib": "^1.17.1",
    "razorpay": "^2.9.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8.5.2",
    "prettier": "^3.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^3.0.5"
  },
  "overrides": {
    "better-auth": {
      "better-call": {
        "zod": "$zod"
      }
    }
  }
